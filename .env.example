# DocSensei App
APP_NAME=DocSensei_API
APP_DESCRIPTION=AI-powered document assistant
APP_VERSION=1.0.0

# AI Models & Limits
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=none

# Optional: used automatically when Groq returns a rate-limit error.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DATA_DIR=./data
CORS_ORIGINS=["http://localhost:5173", "https://docsensei-ai.web.app/"]
MAX_UPLOAD_MB=25
MAX_PAGES=300
